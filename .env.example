# Gemini
# Server-side only. NEVER prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash

# Google Sheets
# Create a Google Cloud service account, enable Google Sheets API,
# and share your target spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace_me
GOOGLE_SHEET_ID=replace_me
GOOGLE_SHEET_NAME=Bookings

# Optional public settings
NEXT_PUBLIC_BUSINESS_NAME=GameZone Arena
NEXT_PUBLIC_CITY=Ahmedabad
